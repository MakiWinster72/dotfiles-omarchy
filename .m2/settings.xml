<settings>
  <mirrors>
    <!-- 相同 mirrorOf 匹配时 Maven 使用第一个镜像，不会自动故障切换。
         如需切换，将需要的 mirror 移至最前面。 -->
    <mirror>
      <id>huaweicloud</id>
      <mirrorOf>central</mirrorOf>
      <name>华为云 Maven 镜像（首选）</name>
      <url>https://repo.huaweicloud.com/repository/maven/</url>
    </mirror>
    <mirror>
      <id>aliyunmaven</id>
      <mirrorOf>central</mirrorOf>
      <name>阿里云公共仓库</name>
      <url>https://maven.aliyun.com/repository/public</url>
    </mirror>
    <mirror>
      <id>central-direct</id>
      <mirrorOf>central</mirrorOf>
      <name>Maven 官方中央仓库（备选）</name>
      <url>https://repo.maven.apache.org/maven2/</url>
    </mirror>
  </mirrors>
</settings>

